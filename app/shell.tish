// Tish playground shell.
//
// All of the editor / files / terminal / preview / layout / persistence /
// hotkeys / share / open-in-new-window logic lives in `SandboxIde` inside
// `tish-ide-panels`, so this file is just the playground's "preset": the
// default file contents, the localStorage namespace, and a tiny Examples
// menu that loads curated starter sandboxes.
//
// History: the bulk of this file (~460 lines of layout, persistence, file
// tabs, hotkey bridges and the postMessage console pipe) was extracted into
// `tish-ide-panels/src/SandboxIde.tish` so tish-learn and tish-ide can mount
// the same component without copying or vendoring it.
//
// Codepen-style sharing:
//   - Click "↗ Share" → a paste-able URL with the current files encoded in
//     `#share=…` is copied to the clipboard. Anyone opening that URL gets the
//     same sandbox in their browser, no backend.
//   - Click "⌬ Embed" → an `<iframe src="…?embed=1#share=…">` snippet is
//     copied so the sandbox can be embedded in any blog / doc.
//   - When opened with `#share=…`, the visitor sees the shared sandbox
//     unmodified; their local edits don't persist until they hit "⑂ Fork",
//     which writes to localStorage and clears the URL.

import { createRoot, useState, useRef, useLayoutEffect } from "lattish"
import { SandboxIde, isEmbedRequested } from "tish-ide-panels"

const DEFAULT_FILES = [
  {
    path: "main.tish",
    text: "// main.tish — primary entry (Lattish app). Styles from web-preview.css.\nif (typeof document !== \"undefined\") {\n  fn App() {\n    let countState = useState(0)\n    let count = countState[0]\n    let setCount = countState[1]\n    return <div class=\"box\">\n      <h1>{\"Web preview works!\"}</h1>\n      <p>{\"This is rendered by Lattish. Edit main.tish and Run to change this.\"}</p>\n      <button type=\"button\" onclick={() => setCount(count + 1)}>{\"Count: \" + count}</button>\n    </div>\n  }\n  createRoot(document.body).render(App)\n}\n"
  },
  {
    path: "lib.tish",
    text: "// lib.tish — second buffer\nconsole.log(\"Hello from lib.tish\")\n"
  },
  {
    path: "web-preview.css",
    text: "/* Base styles for web preview iframe (main.tish runs here). */\nbody {\n  margin: 0;\n  font-family: sans-serif;\n  padding: 1rem;\n  background: #1a1d23;\n  color: #e6e9ed;\n}\n\n/* Example app box (main.tish uses class=\"box\") */\n.box {\n  border: 2px solid #3d8bfd;\n  border-radius: 8px;\n  padding: 1.5rem;\n  max-width: 20rem;\n}\n\n.box h1 {\n  margin: 0 0 0.5rem 0;\n  font-size: 1.25rem;\n}\n\n.box p {\n  margin: 0;\n  font-size: 0.9rem;\n  opacity: 0.9;\n}\n"
  }
]

// Curated starter sandboxes. Each entry is a "load this preset" menu item
// in the Examples dropdown; selecting one replaces the editor contents and
// kicks the user into a fresh local sandbox (clears any #share= URL so the
// fork-style "shared" badge doesn't stick around).
const EXAMPLES = [
  {
    id: "default",
    label: "Counter (default)",
    files: DEFAULT_FILES,
    kind: "ide",
    cssEntryPath: "web-preview.css"
  },
  {
    id: "hello",
    label: "Hello, console",
    kind: "console",
    cssEntryPath: null,
    files: [
      { path: "main.tish", text: "console.log(\"Hello from Tish!\")\nconsole.log(\"Run again to re-execute.\")\n" }
    ]
  },
  {
    id: "fizzbuzz",
    label: "FizzBuzz",
    kind: "console",
    cssEntryPath: null,
    files: [
      { path: "main.tish", text: "let i = 1\nwhile (i <= 15) {\n  let line = \"\"\n  if (i % 15 === 0) { line = \"FizzBuzz\" }\n  else if (i % 3 === 0) { line = \"Fizz\" }\n  else if (i % 5 === 0) { line = \"Buzz\" }\n  else { line = String(i) }\n  console.log(line)\n  i = i + 1\n}\n" }
    ]
  },
  {
    id: "todo",
    label: "Tiny todo (Lattish)",
    kind: "ide",
    cssEntryPath: "web-preview.css",
    files: [
      {
        path: "main.tish",
        text: "if (typeof document !== \"undefined\") {\n  fn App() {\n    let textState = useState(\"\")\n    let listState = useState([])\n    let text = textState[0]\n    let setText = textState[1]\n    let list = listState[0]\n    let setList = listState[1]\n    fn add() {\n      if (text.trim() === \"\") { return }\n      setList(list.concat([text]))\n      setText(\"\")\n    }\n    let items = []\n    let i = 0\n    while (i < list.length) {\n      items.push(<li>{list[i]}</li>)\n      i = i + 1\n    }\n    return <div class=\"todo\">\n      <h1>{\"Todo\"}</h1>\n      <input value={text} oninput={(e) => setText(e.target.value)} placeholder=\"Add an item\" />\n      <button onclick={add}>{\"Add\"}</button>\n      <ul>{items}</ul>\n    </div>\n  }\n  createRoot(document.body).render(App)\n}\n"
      },
      {
        path: "web-preview.css",
        text: ".todo { font-family: sans-serif; padding: 1rem; max-width: 24rem; }\n.todo h1 { margin: 0 0 0.75rem 0; font-size: 1.2rem; }\n.todo input { padding: 0.4rem 0.6rem; border: 1px solid #ccc; border-radius: 4px; margin-right: 0.4rem; }\n.todo button { padding: 0.4rem 0.9rem; border-radius: 4px; border: 1px solid #ccc; cursor: pointer; }\n.todo ul { padding-left: 1.25rem; }\n"
      }
    ]
  }
]

fn ExamplesMenu(props) {
  let openState = useState(false)
  let open = openState[0]
  let setOpen = openState[1]
  let containerRef = useRef(null)

  useLayoutEffect(() => {
    fn onDocClick(e) {
      let host = containerRef.current
      if (host === null) { return }
      if (host.contains(e.target)) { return }
      setOpen(false)
    }
    document.addEventListener("click", onDocClick)
    return () => document.removeEventListener("click", onDocClick)
  }, [])

  let items = []
  let i = 0
  while (i < EXAMPLES.length) {
    let ex = EXAMPLES[i]
    items.push(<button class="pg-examples-item" onclick={() => { setOpen(false); props.onPick(ex) }}>{ex.label}</button>)
    i = i + 1
  }

  return <div ref={containerRef} class="pg-examples">
    <button class="pg-toggle pg-examples-trigger" onclick={() => setOpen(!open)} title="Load a starter sandbox">{"≡ Examples"}</button>
    {open ? <div class="pg-examples-menu">{items}</div> : null}
  </div>
}

fn ShellApp(props) {
  // The Examples menu mounts SandboxIde with a different `key` on each pick
  // so the component remounts cleanly with the new files (and the share-load
  // logic inside re-runs against the same URL — but we clear the hash before
  // setting a new key, so it doesn't bounce back to share mode).
  let presetState = useState(EXAMPLES[0])
  let preset = presetState[0]
  let setPreset = presetState[1]
  let mountKeyState = useState(0)
  let mountKey = mountKeyState[0]
  let setMountKey = mountKeyState[1]

  fn pickExample(ex) {
    if (typeof history !== "undefined" && history.replaceState !== undefined && typeof location !== "undefined") {
      try {
        history.replaceState(null, "", String(location.origin) + String(location.pathname))
      } catch (_) { }
    }
    setPreset(ex)
    setMountKey(mountKey + 1)
  }

  let embed = props.embed === true
  let mode = embed ? "embed" : "full"
  let storageKey = embed ? null : "tish-playground"

  return <div class="pg-playground-root">
    {!embed
      ? <div class="pg-toolbar-top">
          <ExamplesMenu onPick={pickExample} />
        </div>
      : null}
    <div class="pg-playground-mount" key={String(mountKey)}>
      {SandboxIde({
        files: preset.files,
        entryPath: "main.tish",
        kind: preset.kind,
        cssEntryPath: preset.cssEntryPath,
        mode: mode,
        storageKey: storageKey,
        title: "Tish playground",
        enableShare: true,
        enableNewWindow: !embed,
        loadShareFromUrl: true
      })}
    </div>
  </div>
}

export fn mountShell(root) {
  if (root === null || root === undefined) { return }
  let embed = isEmbedRequested()
  if (embed) {
    root.className = "pg-root pg-embed-host"
  } else {
    root.className = "pg-root"
  }
  fn App() { return ShellApp({ embed: embed }) }
  createRoot(root).render(App)
}
